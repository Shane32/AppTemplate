{
  "name": "reactapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "codegen": "rimraf --glob \"src/**/*.g.ts\" \"src/**/*.g.tsx\" && graphql-codegen",
    "dev": "npm run codegen && concurrently --kill-others \"vite\" \"graphql-codegen --watch\"",
    "build": "npm run codegen:production && npm run typecheck && vite build",
    "build-ci": "npm run build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prettier:check": "prettier . --check",
    "prepare": "cd .. && husky ReactApp/.husky",
    "test": "",
    "codegen:production": "rimraf --glob \"src/**/*.g.ts\" \"src/**/*.g.tsx\" && graphql-codegen --config codegen-production.ts",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": "^22.22.1 || ^24.0.0",
    "npm": "^10.9.2 || ^11.0.0"
  },
  "dependencies": {
    "@shane32/graphql": "^6.1.0",
    "@shane32/msoauth": "^3.0.2",
    "bootstrap": "^5.3.8",
    "graphiql": "^5.4.0",
    "graphql": "^16.14.2",
    "monaco-editor": "~0.52.2",
    "monaco-graphql": "^1.9.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sass": "^1.106.1"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/plugin-helpers": "^7.4.2",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@parcel/watcher": "^2.6.0",
    "@shane32/graphql-codegen-near-operation-file-plugin": "^1.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --report-unused-disable-directives --no-warn-ignored --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,json,js,jsx,css,scss,html}": "prettier --write"
  }
}
